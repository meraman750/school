# Copy to .env in repo root for: docker compose -f docker-compose.prod.yml --env-file .env up --build -d

# --- Required: change every value before production ---
SECRET_KEY=generate-a-long-random-secret-key
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=https://yourdomain.com/dashboard

# Public API URL (used when building frontends)
VITE_API_URL=https://yourdomain.com/api/v1

# Database (matches compose service `db`)
DB_NAME=biruk_academy
DB_USER=biruk
DB_PASSWORD=change-me-strong-db-password

# Demo login helpers on dashboard (keep false in production)
VITE_SHOW_DEMO=false

# TLS (nginx terminates HTTPS; backend sees X-Forwarded-Proto)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Email (password reset)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
