# Django
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - set USE_SQLITE=False to use PostgreSQL
USE_SQLITE=True
DB_NAME=biruk_academy
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS (add your production domains)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Redis (rate limits + cache; required for multi-worker production)
REDIS_URL=

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@birukacademy.edu

# Frontend (password reset links)
FRONTEND_URL=http://localhost:3001/dashboard

# Rate Limiting
RATELIMIT_ENABLE=True

# Production only (see DEPLOY.md)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
USE_X_FORWARDED_HOST=True
