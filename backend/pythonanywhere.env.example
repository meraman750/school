# Copy values into PythonAnywhere → Web → Environment variables (or your WSGI file).
# Replace YOURUSER and URLs after Cloudflare Pages deploy.

SECRET_KEY=generate-long-random-secret
DEBUG=False
USE_SQLITE=false

DB_HOST=ep-xxxx.region.aws.neon.tech
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=neon-password-from-dashboard
DB_PORT=5432
DB_SSLMODE=require

ALLOWED_HOSTS=YOURUSER.pythonanywhere.com

CORS_ALLOWED_ORIGINS=https://biruk-website.pages.dev,https://biruk-dashboard.pages.dev
FRONTEND_URL=https://biruk-dashboard.pages.dev/login

SECURE_SSL_REDIRECT=True
VITE_SHOW_DEMO=false

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Leave empty on PythonAnywhere free tier (rate limits use in-memory cache per worker)
REDIS_URL=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@birukacademy.edu
